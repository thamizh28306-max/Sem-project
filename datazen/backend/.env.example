# ─── DataZen Backend Environment Variables ───────────────────────────────────
# Copy to .env and fill in your own values. NEVER commit .env to git.

# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/datazen

# JWT access token secret — min 32 chars, must differ from REFRESH_SECRET
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET_HERE

# JWT refresh token secret — min 32 chars, must differ from JWT_SECRET  
REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_SECRET_HERE

# Comma-separated allowed CORS origins (no trailing slash, no wildcards)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:5173

# Device authentication keys for ESP32 sensor ingestion (comma-separated id:key pairs)
# Format: device1:secretkey1,device2:secretkey2
DEVICE_KEYS=esp32-001:REPLACE_WITH_DEVICE_KEY

# ML microservice internal base URL
ML_SERVICE_URL=http://localhost:8000

# Internal shared secret between backend and ML service (min 16 chars)
ML_INTERNAL_KEY=REPLACE_WITH_ML_INTERNAL_KEY

NODE_ENV=development
PORT=3000

# Set to 1 if running behind a reverse proxy (nginx, etc.)
# TRUST_PROXY=1
