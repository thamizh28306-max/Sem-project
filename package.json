{
  "name": "datazen",
  "version": "1.0.0",
  "description": "DataZen - Chennai Property Intelligence Platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "serve:frontend": "npx serve frontend -l 5173 --cors",
    "serve:all": "npx concurrently \"npm run dev\" \"npm run serve:frontend\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "serve": "^14.2.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
